PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mien_tay_tourism
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI Travel Planner (server-side only — never expose these to the frontend)
# Get an OpenWeather key at https://openweathermap.org/api (free tier works
# with the 5-day / 3-hour forecast used by POST /api/ai/travel-plan).
OPENWEATHER_API_KEY=
# Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
